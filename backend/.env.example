NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=linkforge
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Generate distinct random values of at least 32 characters for each deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
VISITOR_HASH_SALT=replace-with-a-different-random-value-at-least-32-characters

REDIS_URL=redis://localhost:6379
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
URL_RATE_LIMIT_WINDOW_SECONDS=60
URL_RATE_LIMIT_MAX=100
REDIRECT_RATE_LIMIT_WINDOW_SECONDS=60
REDIRECT_RATE_LIMIT_MAX=60
ANALYTICS_JOB_ATTEMPTS=3
ANALYTICS_JOB_BACKOFF_MS=1000
ANALYTICS_WORKER_CONCURRENCY=5
CACHE_TTL_SECONDS=300
JSON_BODY_LIMIT=16kb
# Set only when deployed behind a known number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1
